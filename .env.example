NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/saloonsync?schema=app
# Runtime pg adapter settings; budget across every web instance and worker.
DB_POOL_MAX=5
DB_CONNECT_TIMEOUT_MS=5000
DB_IDLE_TIMEOUT_MS=60000
DB_MAX_LIFETIME_SECONDS=600
DB_STATEMENT_TIMEOUT_MS=15000
DB_TIMING_DEBUG=0
# Optional one-time region transfer. Keep values only in .env.local.
NEW_DATABASE_URL=
NEW_DIRECT_URL=
NEW_SUPABASE_URL=
NEW_SUPABASE_PUBLISHABLE_KEY=
# Set true only after transferring encryption keys and verifying existing MFA.
MIGRATION_ENCRYPTION_KEY_COPIED=false
# Optional protected Prometheus scrape endpoint; at least 32 random characters.
METRICS_SECRET=
# Opt-in first-party LCP/INP/CLS collection, without cookies or page identifiers.
ENABLE_WEB_VITALS=false
DIRECT_URL=postgresql://postgres:postgres@localhost:5432/saloonsync?schema=app
APP_ORIGIN=http://localhost:3000
# Match this with the configured Supabase password minimum (at least 8).
AUTH_PASSWORD_MIN_LENGTH=12
# Registration stays disabled until finalized HTTPS documents and a version exist.
LEGAL_TERMS_URL=
LEGAL_PRIVACY_URL=
LEGAL_DOCUMENT_VERSION=
# Optional invitation delivery (verification/recovery remain provider-managed).
RESEND_API_KEY=
EMAIL_FROM=

# Optional private portfolio/receipt storage. Never expose this key to a browser.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_PORTFOLIO_BUCKET=
# Optional WhatsApp delivery. Use approved templates with variables 1/2/3.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=
TWILIO_TEMPLATE_CONFIRMATION=
TWILIO_TEMPLATE_REMINDER=
TWILIO_TEMPLATE_REBOOKING=
TWILIO_TEMPLATE_FEEDBACK=
TWILIO_TEMPLATE_CAMPAIGN=
# At least 32 random characters; used only by the scheduled server worker.
COMMUNICATIONS_WORKER_SECRET=

# Optional Google Calendar OAuth and encrypted offline tokens.
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
# Base64 encoding of 32 cryptographically random bytes.
CALENDAR_TOKEN_ENCRYPTION_KEY=
CALENDAR_WORKER_SECRET=

# Optional: call POST /api/internal/services every minute with this Bearer secret
# to finish elapsed services even when all appointment screens are closed.
# Use at least 32 random characters.
SERVICE_WORKER_SECRET=

# Optional Upstash Redis for layout data caching and login/register rate limiting.
UPSTASH_REDIS_REST_URL="https://eager-boxer-69437.upstash.io"
UPSTASH_REDIS_REST_TOKEN="gQAAAAAAAQ89AAIgcDIxYWRiMzk5Nzg0MDQ0OTQ0YWZkNGExYmY1NDIxYzRmMw"

# Optional Upstash Redis for layout data caching and login/register rate limiting.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
