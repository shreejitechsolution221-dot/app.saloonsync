  userId String @db.Uuid
  clockedInAt DateTime @default(now()) @db.Timestamptz
  clockedOutAt DateTime? @db.Timestamptz
  breakStartedAt DateTime? @db.Timestamptz
  breakMinutes Int @default(0)
  @@index([salonId,userId,clockedInAt])
  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @updatedAt @db.Timestamptz
  @@unique([id,salonId])
  @@schema("app")
}

model Shift {
  cancelledAt DateTime? @db.Timestamptz
  id String @id @default(uuid()) @db.Uuid
  salonId String @db.Uuid
  branchId String @db.Uuid
  userId String @db.Uuid
  startsAt DateTime @db.Timestamptz
  endsAt DateTime @db.Timestamptz
  @@index([salonId,branchId,startsAt])
  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @updatedAt @db.Timestamptz
  @@unique([id,salonId])
  @@schema("app")
}

model RevenueTarget {
  id String @id @default(uuid()) @db.Uuid
  salonId String @db.Uuid
  branchId String @db.Uuid
  period String
  startsOn DateTime @db.Date
  amountPaise Int
  @@unique([salonId,branchId,period,startsOn])
  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @updatedAt @db.Timestamptz
  @@unique([id,salonId])
  @@schema("app")
}

model TaskTemplate {
  id String @id @default(uuid()) @db.Uuid
  salonId String @db.Uuid
  title String
  category String
  active Boolean @default(true)
  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @updatedAt @db.Timestamptz
  @@unique([id,salonId])
  @@schema("app")
}

model DailyTask {
  id String @id @default(uuid()) @db.Uuid
  salonId String @db.Uuid
  branchId String @db.Uuid
  templateId String @db.Uuid
  businessDate DateTime @db.Date
  completedBy String? @db.Uuid
  completedAt DateTime? @db.Timestamptz
  @@unique([salonId,branchId,templateId,businessDate])
  createdAt DateTime @default(now()) @db.Timestamptz
